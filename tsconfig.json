{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    // محرك اللعبة منقول من كود JS أصلي حيث كل وصول للمصفوفات محسوب ضمن حدودها ثابتًا
    // (أطوال اللوحة/الأدوات معروفة ومضمونة وقت الكتابة)، فنعطّل هذا الفحص بدل حشو الكود بتحقّقات لا طائل منها
    "noUncheckedIndexedAccess": false
  }
}
